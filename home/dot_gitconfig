# .gitconfig - shared configuration

[include]
    path = ~/.gitconfig.local

[core]
    editor = nvim
    excludesfile = ~/.gitignore_global
    autocrlf = input
    pager = less -FRX

[init]
    defaultBranch = main

[pull]
    rebase = false

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true

[diff]
    colorMoved = default

[merge]
    conflictstyle = diff3

[color]
    ui = auto

[alias]
    st = status -sb
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate
    lga = log --oneline --graph --decorate --all
    last = log -1 HEAD --stat
    unstage = reset HEAD --
    amend = commit --amend --no-edit